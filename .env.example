# 真实密钥不放这里。密钥文件在工作区级（项目目录之外）：
#   <workspace>/.secrets/oncall-copilot.env
# 使用方式：export ONCALL_ENV_FILE=<workspace>/.secrets/oncall-copilot.env
# 冒烟验证：python scripts/smoke_api.py

# ── LLM（唯一计费项）──────────────────────────────
LLM_PROVIDER=deepseek
# 实测该账号下 deepseek-chat 只是别名（响应 model 回 deepseek-flash），显式写实际模型
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Embedding / Rerank（硅基流动，免费额度）──────────
SF_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SF_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── 检索参数 ─────────────────────────────────────
TOP_K_VEC=20
TOP_K_BM25=20
TOP_K_FINAL=5
RRF_K=60
ABSTAIN_THRESHOLD=0.35

# ── 路径 ─────────────────────────────────────────
DATA_DIR=./data
CONTENT_DIR=./content

# ── 服务 ─────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
